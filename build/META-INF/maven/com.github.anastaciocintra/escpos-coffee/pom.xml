      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Marco Antonio Anastacio Cintra</name>
      <email>anastaciocintra@gmail.com</email>
      <url>https://github.com/anastaciocintra</url>
      <roles>
        <role>Lead Developer</role>
